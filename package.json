{
  "name": "pdf-cite-locate",
  "version": "0.1.1",
  "description": "Locate RAG citation strings inside pdf.js text content: approximate matching, line rectangles, viewport coordinates, optional React overlay. Zero dependencies, does not import pdfjs.",
  "license": "MIT",
  "type": "module",
  "keywords": ["pdf", "pdfjs", "rag", "citation", "highlight", "react-pdf", "fuzzy-match"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
    "./dom": { "types": "./dist/dom/index.d.ts", "import": "./dist/dom/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "README.ko.md", "CHANGELOG.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/LeeGyeongPil/pdf-cite-locate.git" },
  "homepage": "https://github.com/LeeGyeongPil/pdf-cite-locate#readme",
  "bugs": "https://github.com/LeeGyeongPil/pdf-cite-locate/issues",
  "sideEffects": false,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/web/tsconfig.json",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check:no-pdfjs-import": "node scripts/check-no-pdfjs-import.mjs",
    "example": "npm run build --silent && node examples/node/locate.mjs",
    "example:web": "vite examples/web",
    "example:build": "vite build examples/web"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pdfjs-dist-6.5": "npm:pdfjs-dist@6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "11.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
